# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'librese' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 27 nao aceita alvo abaixo do iOS 15 (o RNSVGFilters do react-native-svg pede 12.4)
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |cfg|
        alvo = cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if alvo && Gem::Version.new(alvo) < Gem::Version.new('15.0')
          cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        end
      end
    end
  end

  # O MediaPipe (detector de maos do Libre-se) vem em .xcframework com o Info.plist dizendo
  # "MediaPipeTasksCommon.a", mas o conteudo e um .framework: o CocoaPods gera -l"MediaPipe..."
  # e o linker nao acha. Troca por -framework e aponta a pasta onde o Xcode extrai o framework.
  post_integrate do |installer|
    installer.aggregate_targets.each do |agg|
      agg.user_build_configurations.keys.each do |config|
        path = agg.xcconfig_path(config)
        next unless File.exist?(path)
        texto = File.read(path)
        novo = texto.gsub(/-l"(MediaPipeTasks(?:Common|Vision))"/, '-framework "\1"')
        if novo != texto
          novo = novo.sub(/^FRAMEWORK_SEARCH_PATHS = \$\(inherited\)/,
            'FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_XCFRAMEWORKS_BUILD_DIR}/MediaPipeTasksCommon" "${PODS_XCFRAMEWORKS_BUILD_DIR}/MediaPipeTasksVision"')
          File.write(path, novo)
        end
      end
    end
  end
end
